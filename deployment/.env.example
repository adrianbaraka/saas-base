# the public frontend url reachable from the internet
APP_URL=http://192.168.1.100:3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# db config
DB_USER=user
DB_PASSWORD=password
DB_NAME=test
DB_PORT=5433

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://user:password@base-db:5432/test
#DATABASE_URL=postgres://user:password@localhost:5433/test

# the backend container name
BACKEND_URL=http://base-backend:8000

# these vars are used to create the initial admin user if no admin exists
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=

# [basically trusting proxies]
# https://svelte.dev/docs/kit/adapter-node#Environment-variables-ADDRESS_HEADER-and-XFF_DEPTH
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# cache the session for this minutes preventing hitting the db on every request
# keep this low though at most 5 mins
CACHE_MINUTES=


# outgoing email via Resend
RESEND_API_KEY=
EMAIL_FROM=""


# with this flag set to anything but the string true emails will not be sent but printed to the console
# to send email NODE_ENV must be set to production and SEND_EMAIL=true
SEND_EMAIL=true