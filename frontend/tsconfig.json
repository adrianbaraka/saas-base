{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"allowImportingTsExtensions": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowArbitraryExtensions": true
	},
	"include": ["src", "vite.config.ts", "prettier.config.js", "eslint.config.js"]
}
