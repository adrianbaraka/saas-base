# openssl rand -base64 32
BETTER_AUTH_SECRET=

# http://localhost:5173
# this is the url prepended for callback url emails
# in this case point to the frontend URL since its the one publicly reachable
BETTER_AUTH_URL=

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# postgres://<user>:<password>@<host>:<port>/<database>
# postgres://postgres:mypassword@localhost:5432/postgres
DATABASE_URL=


# these vars are used to create the initial admin user if no admin exists
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=

# cache the session for this minutes preventing hitting the db on every request
# keep this low though at most 5 mins
# an effect is say banning a user it won't come to effect till this duration passes
CACHE_MINUTES=0
