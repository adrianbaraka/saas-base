DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# postgres://<user>:<password>@<host>:<port>/<database>
# postgres://user:password@localhost:5432/postgres
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# http://localhost:5173
# this is the url prepended for callback url emails
# in this case point to the frontend URL since its the one publicly reachable
BETTER_AUTH_URL=

# cache the session for this minutes preventing hitting the db on every request
# keep this low though at most 5 mins
# an effect is say banning a user it won't come to effect till this duration passes
CACHE_MINUTES=0

RESEND_API_KEY=

EMAIL_FROM="UnifyEdu <info@edu.unifyworksglobal.com>"

# with this flag set to anything but the string true emails will not be sent but printed to the console
# to send email NODE_ENV must be set to production and SEND_EMAIL=true
SEND_EMAIL=true

# a dev flag to skip running migrations on startup
# if set to anything it skips
SKIP_MIGRATIONS=


# these vars are used to create the initial admin user if no admin exists
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
